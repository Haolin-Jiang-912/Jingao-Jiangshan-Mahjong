{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jingao-jiangshan-mahjong",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "MAHJONG_ROOMS", "class_name": "MahjongRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MahjongRoom"] }]
}
